#include <winres.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@HCSE_NAME@ - SKSE Plugin"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "@HCSE_ID@"
            VALUE "LegalCopyright", "@HCSE_AUTHOR@; based on SCIE by ohfor (MIT)"
            VALUE "OriginalFilename", "@HCSE_ID@.dll"
            VALUE "ProductName", "@HCSE_NAME@"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
